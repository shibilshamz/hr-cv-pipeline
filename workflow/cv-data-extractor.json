    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "YOUR_ANTHROPIC_API_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a CV data extraction specialist. Return ONLY valid JSON, no explanation.\\n\\nRules:\\n- Empty string if not found\\n- For relevant_years_of_experience, calculate from earliest job to Aug 2026 and format as 'X years Y months' (e.g. '6 years 10 months')\\n- For gcc_experience, calculate years in GCC countries and format as 'X years Y months'\\n- last_company and last_job_title = most recent role\\n- For contact_number, return the number exactly as written with country code, as a plain string\\n\\nFields:\\n{\\\"full_name\\\":\\\"\\\",\\\"contact_number\\\":\\\"\\\",\\\"nationality\\\":\\\"\\\",\\\"email_id\\\":\\\"\\\",\\\"current_location\\\":\\\"\\\",\\\"visa_status\\\":\\\"\\\",\\\"last_company\\\":\\\"\\\",\\\"last_job_title\\\":\\\"\\\",\\\"relevant_years_of_experience\\\":\\\"\\\",\\\"gcc_experience\\\":\\\"\\\",\\\"current_salary\\\":\\\"\\\",\\\"expected_salary\\\":\\\"\\\",\\\"notice_period\\\":\\\"\\\",\\\"reason_for_leaving\\\":\\\"\\\"}\\n\\nCV Text:\\n\" + $json.text\n    }\n  ]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        624,
        0
      ],
      "id": "65fe1af5-eca2-47b8-bdae-2a824f64f3f0",
      "name": "Claude Extract"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs once per item — $input.item is THIS CV, not item 0\nconst raw = $input.item.json.content?.[0]?.text ?? '';\nconst sourceFile = $('Watch Inbox').item.json.name;\nconst fileId = $('Watch Inbox').item.json.id;\nconst processedAt = new Date().toISOString();\n\nlet data;\ntry {\n  const clean = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n  data = JSON.parse(clean);\n} catch (e) {\n  return {\n    json: {\n      _error: `JSON parse failed: ${e.message}`,\n      _raw: raw.slice(0, 500),\n      _source_file: sourceFile,\n      _file_id: fileId,\n      _processed_at: processedAt,\n    }\n  };\n}\n\n// Stop Google Sheets treating \"+971...\" as a formula\nif (data.contact_number) {\n  data.contact_number = \"'\" + String(data.contact_number).replace(/^'/, '');\n}\n\ndata._source_file = sourceFile;\ndata._file_id = fileId;\ndata._processed_at = processedAt;\n\nreturn { json: data };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0

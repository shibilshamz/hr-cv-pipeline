    {
      "parameters": {
        "jsCode": "const existing = new Set(\n  $input.all()\n    .map(i => String(i.json['Email Id'] ?? '').toLowerCase().trim())\n    .filter(Boolean)\n);\n\nconst seen = new Set();\n\nreturn $('Parse Response').all()\n  .filter(i => !i.json._error)\n  .map(i => {\n    const email = String(i.json.email_id ?? '').toLowerCase().trim();\n    const dup = !email || existing.has(email) || seen.has(email);\n    if (!dup) seen.add(email);\n    return { json: { ...i.json, _is_duplicate: dup } };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
